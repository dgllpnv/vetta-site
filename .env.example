# ===========================================
# AURI SOLUTIONS — variaveis de ambiente
# ===========================================
# Copie este arquivo para .env (local) ou cole o conteudo na aba Ambiente
# do servico no EasyPanel (producao).

# ===========================================
# DATABASE — PostgreSQL
# ===========================================
# Local (Docker compose ou Postgres host): aponte para o seu Postgres local
# Producao (EasyPanel): use o hostname interno <projeto>_<servico>
#   Ex: projeto "auri", servico "auri-postgres" -> hostname "auri_auri-postgres"
#   String completa: postgresql://auri_user:SENHA@auri_auri-postgres:5432/auri_db
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Mesma URL — Prisma usa para "directUrl" em ambientes serverless/pooled.
# Em Postgres tradicional (EasyPanel), pode ser identica a DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ===========================================
# APP CONFIG
# ===========================================
# URL publica do site. CONGELADA EM BUILD TIME (Next.js le NEXT_PUBLIC_*
# durante o build, nao em runtime). Ao mudar, faca Implantar (rebuild),
# nao apenas Reiniciar.
# Local:     http://localhost:3000
# Producao:  https://aurisolutions.com.br
NEXT_PUBLIC_SITE_URL="https://aurisolutions.com.br"
