# ===========================================
# DATABASE (Railway PostgreSQL)
# ===========================================
# Use a URL do TCP Proxy do Railway para conexões externas:
# Railway > PostgreSQL > Settings > Networking > TCP Proxy
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"

# Para Vercel, use a URL interna do Railway:
# DATABASE_URL="postgresql://USER:PASSWORD@postgres.railway.internal:5432/railway"

